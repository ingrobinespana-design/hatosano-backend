# Copia estas variables en Render/Railway (NO subas tus valores reales a GitHub)

# Cadena de conexión del Postgres-xgPP (Railway -> Postgres-xgPP -> Connect -> Public Network)
DATABASE_URL=postgresql://postgres:CLAVE@HOST.proxy.rlwy.net:PUERTO/railway

# Clave secreta para firmar los tokens de sesión (pon una larga y aleatoria)
JWT_SECRET=pon-aqui-una-clave-larga-y-secreta
